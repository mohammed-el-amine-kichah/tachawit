# Supabase project URL and publishable (anon) key.
# Local: run `pnpm db:start`, then copy "API_URL" and "PUBLISHABLE_KEY" from `pnpm exec supabase status -o env`.
# Hosted: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, server only (never NEXT_PUBLIC_). Used to list words still missing audio for the
# Contribute page. Local: "SECRET_KEY" from `pnpm exec supabase status -o env`. Hosted: Project Settings → API Keys.
# Without it, speakers can still record words of their own choice.
SUPABASE_SECRET_KEY=

# Public address of the site, used in sign-in links (e.g. https://tachawit.app). Optional locally.
NEXT_PUBLIC_SITE_URL=

# Google sign-in for local Supabase (optional; see README). Hosted projects configure this in the dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
