{
  "unit": {
    "id": "7c030000-0000-4000-8000-000000000001",
    "slug": "numbers-days-time",
    "title": {
      "en": "Numbers, Days & Time",
      "fr": "Nombres, jours et temps",
      "ar": "الأعداد والأيام والوقت"
    },
    "description": {
      "en": "Count from one to ten, and talk about today, tomorrow and the new year.",
      "fr": "Compter de un à dix, parler d'aujourd'hui, de demain et du nouvel an.",
      "ar": "عُدّ من واحد إلى عشرة، وتحدّث عن اليوم والغد ورأس السنة."
    },
    "map_theme": "aures_peaks"
  },
